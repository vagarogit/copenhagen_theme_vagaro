@zendesk:registry=https://registry.npmjs.org/

# vera-chat-widget is published unscoped, so the Vera feed has to be the default
# registry (it proxies npmjs via its upstream). Without this, bumping the widget's
# version fails to resolve: yarn asks registry.yarnpkg.com and gets a 404.
registry=https://pkgs.dev.azure.com/Vagaro/_packaging/VagaroVeraCharbot/npm/registry/
@vagaro:registry=https://pkgs.dev.azure.com/Vagaro/_packaging/ReactToolkit/npm/registry/

# Auth tokens for both feeds live in ~/.npmrc (npm and yarn merge user config with
# this file). Never put an _authToken in here — this file is committed.
